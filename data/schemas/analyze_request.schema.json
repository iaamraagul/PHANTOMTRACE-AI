{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalyzeRequest",
  "type": "object",
  "required": ["url"],
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048
    },
    "include_threat_intelligence": {
      "type": "boolean",
      "default": true
    }
  }
}
